# CORS Origins (REQUIRED - Update after frontend deployment)
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://your-vercel-app.vercel.app

# Server Port (REQUIRED)
PORT=8080

# Optional: Java Options
JAVA_OPTS=-Xmx512m -Xms256m
